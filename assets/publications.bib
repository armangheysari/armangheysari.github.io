@article{gheysari2025security,
  title   = {Security-aware optimization of {PoW}-based blockchain performance using a genetic algorithm approach},
  author  = {Gheysari, Arman and Zarandi, Hamid R.},
  journal = {Sustainable Computing: Informatics and Systems},
  volume  = {},
  number  = {},
  pages   = {101232},
  year    = {2025},
  month   = oct,
  publisher = {Elsevier},
  doi     = {10.1016/j.suscom.2025.101232},
  url     = {https://www.sciencedirect.com/science/article/abs/pii/S2210537925001532},
  keywords = {Blockchain, Proof-of-Work, Genetic Algorithm, Security, Selfish Mining, Eclipse Attack, Optimization},
  abstract= {Proof of Work (PoW) Blockchain networks face significant challenges in balancing security and performance. Various attacks, such as selfish mining and Eclipse attacks, pose serious threats to the sustainability of these networks. This paper presents an optimization method of configuring consensus algorithm and network parameters using a Genetic Algorithm (GA). Our goal is to enhance performance while maintaining security. We specifically target key parameters for optimization: block size, block interval, and block propagation mechanism.}
}

@article{abdolhosseini2025simultaneous,
  title   = {Simultaneous optimization of network-on-chip to improve reliability and reduce average packet latency considering buffer size constraints},
  author  = {Abdolhosseini, Hesam and Zarandi, Hamid R. and Gheysari, Arman},
  journal = {The Journal of Supercomputing},
  volume  = {81},
  number  = {13},
  year    = {2025},
  month   = aug,
  publisher = {Springer},
  url     = {https://www.springerprofessional.de/en/simultaneous-optimization-of-network-on-chip-to-improve-reliabil/51370836},
  keywords = {Network-on-Chip, Reliability, Latency, NSGA-II, Multi-objective Optimization, Buffer Size, Mesh, Garnet 2.0},
  abstract= {This study delves into the optimization of Network-on-Chip (NoC) architectures, focusing on enhancing reliability and reducing average packet latency while considering buffer size constraints. The research explores the impact of permanent faults on NoC performance and the crucial role of buffer management in optimizing these architectures. The study employs the NSGA-II algorithm for multi-objective optimization, presenting a detailed analysis of the trade-offs between reliability and performance.}
}

@inproceedings{gheysari2025optimizing,
  title     = {Optimizing Proof-of-Work Blockchain Network Communications Using Genetic Algorithm},
  author    = {Gheysari, Arman and Almahdawi, Murtadha and Zarandi, Hamid R.},
  booktitle = {IEEE Conference Proceedings},
  year      = {2025},
  month     = apr,
  publisher = {IEEE},
  url       = {https://ieeexplore.ieee.org/iel8/10967264/10967397/10967452.pdf},
  keywords  = {Blockchain, Proof-of-Work, Genetic Algorithm, Network Topology, Communication Overhead, Optimization},
  abstract  = {Proof-of-Work (PoW) blockchains are a fundamental component of decentralized systems, ensuring security and consensus through computational processes. However, their widespread adoption has highlighted critical challenges, including excessive communication overhead and resource consumption, which can hinder scalability and operational efficiency. This study tackles these issues by optimizing network topologies in PoW blockchains using advanced tool. Through the application of a genetic algorithm, we systematically generate and refine network configurations to minimize communication costs, measured by the total data exchanged during essential operations such as transaction propagation and block dissemination.}
}
